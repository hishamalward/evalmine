{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evalmine.dev/schemas/external.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["external_artifacts", "version", "question", "artifacts", "evaluation"],
  "properties": {
    "external_artifacts": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "version": { "const": 1 },
    "question": { "type": "string", "minLength": 1 },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "$ref": "#/$defs/relativePath" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectives", "blind", "human", "judge"],
      "properties": {
        "objectives": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "blind": { "const": "condition" },
        "ranking_style": { "enum": ["pairwise", "n-way"] },
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "human": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required"],
          "properties": {
            "required": { "type": "boolean" },
            "labels_per_pair": { "type": "integer", "minimum": 1 },
            "coverage": { "const": "calibration-subset" }
          }
        },
        "judge": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "pairwise", "position_swap", "calibrate"],
          "properties": {
            "enabled": { "type": "boolean" },
            "pairwise": { "type": "boolean" },
            "position_swap": { "type": "boolean" },
            "calibrate": { "type": "boolean" },
            "runner": {
              "enum": ["api-prompt", "claude-code", "codex-cli", "gemini-cli"]
            },
            "model": { "type": "string", "minLength": 1 },
            "max_cost_usd": { "type": "number", "exclusiveMinimum": 0 },
            "max_tokens": { "type": "integer", "minimum": 64, "maximum": 32768 },
            "min_kappa": { "type": "number", "minimum": -1, "maximum": 1 },
            "min_labels": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "^/" },
          { "pattern": "(^|/)\\.\\.(/|$)" },
          { "pattern": "(^|/)\\.(/|$)" },
          { "pattern": "\\\\" }
        ]
      }
    }
  }
}
